// Prisma schema for Restaurant Cash Flow Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User & Authentication
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  restaurants RestaurantUser[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Restaurant & Organization
// ============================================================================

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  timezone  String   @default("America/New_York")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cost percentage targets
  targetFoodCostPct    Decimal? @db.Decimal(5, 2)
  targetLaborCostPct   Decimal? @db.Decimal(5, 2)
  targetAlcoholCostPct Decimal? @db.Decimal(5, 2)

  // Relations
  users           RestaurantUser[]
  bankAccounts    BankAccount[]
  weeklyReports   WeeklyReport[]
  sales           Sale[]
  expenses        Expense[]
  payrollEntries  PayrollEntry[]
  vendorInvoices  VendorInvoice[]
  integrations    Integration[]

  @@map("restaurants")
}

model RestaurantUser {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("restaurant_users")
}

enum UserRole {
  OWNER
  MANAGER
  VIEWER
}

// ============================================================================
// Bank Accounts & Transactions
// ============================================================================

model BankAccount {
  id              String          @id @default(cuid())
  restaurantId    String
  name            String
  accountType     BankAccountType
  institutionName String?
  accountMask     String? // Last 4 digits
  plaidAccountId  String? // For Plaid integration
  currentBalance  Decimal?        @db.Decimal(12, 2)
  balanceUpdatedAt DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("bank_accounts")
}

enum BankAccountType {
  OPERATING
  PAYROLL
  SALES_TAX
  SAVINGS
}

model Transaction {
  id              String            @id @default(cuid())
  bankAccountId   String
  plaidTransactionId String?        @unique
  date            DateTime
  description     String
  amount          Decimal           @db.Decimal(12, 2) // Positive = credit, Negative = debit
  category        String?
  merchantName    String?
  pending         Boolean           @default(false)
  transactionType TransactionType?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, date])
  @@map("transactions")
}

enum TransactionType {
  REVENUE
  PAYROLL_TRANSFER
  TAX_TRANSFER
  VENDOR_PAYMENT
  OWNER_DISTRIBUTION
  OTHER
}

// ============================================================================
// Sales & Revenue (from Toast POS)
// ============================================================================

model Sale {
  id           String   @id @default(cuid())
  restaurantId String
  date         DateTime
  toastOrderId String?  @unique

  // Revenue breakdown
  grossSales      Decimal @db.Decimal(12, 2)
  discounts       Decimal @default(0) @db.Decimal(12, 2)
  voids           Decimal @default(0) @db.Decimal(12, 2)
  netSales        Decimal @db.Decimal(12, 2)

  // Payment breakdown
  cashSales       Decimal @default(0) @db.Decimal(12, 2)
  creditCardSales Decimal @default(0) @db.Decimal(12, 2)
  otherSales      Decimal @default(0) @db.Decimal(12, 2)

  // Tips
  tipsCash        Decimal @default(0) @db.Decimal(12, 2)
  tipsCreditCard  Decimal @default(0) @db.Decimal(12, 2)

  // Tax collected
  salesTax        Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@map("sales")
}

// ============================================================================
// Expenses
// ============================================================================

model Expense {
  id           String       @id @default(cuid())
  restaurantId String
  date         DateTime
  category     ExpenseCategory
  subcategory  String?
  vendor       String?
  description  String?
  amount       Decimal      @db.Decimal(12, 2)
  invoiceNumber String?
  dueDate      DateTime?
  paidDate     DateTime?
  isPaid       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@index([restaurantId, category])
  @@map("expenses")
}

enum ExpenseCategory {
  FOOD
  ALCOHOL
  LABOR
  RENT
  UTILITIES
  INSURANCE
  EQUIPMENT
  MARKETING
  SUPPLIES
  REPAIRS
  TAXES
  OTHER
}

// ============================================================================
// Payroll (from Gusto/Toast Payroll)
// ============================================================================

model PayrollEntry {
  id           String   @id @default(cuid())
  restaurantId String
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  payDate        DateTime

  grossWages      Decimal @db.Decimal(12, 2)
  employerTaxes   Decimal @default(0) @db.Decimal(12, 2)
  employerBenefits Decimal @default(0) @db.Decimal(12, 2)
  totalCost       Decimal @db.Decimal(12, 2) // Total employer cost

  employeeCount   Int?
  hoursWorked     Decimal? @db.Decimal(10, 2)

  gustoPayrollId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, payDate])
  @@map("payroll_entries")
}

// ============================================================================
// Vendor Invoices (from vendor portals)
// ============================================================================

model VendorInvoice {
  id           String   @id @default(cuid())
  restaurantId String
  vendorName   String
  vendorType   VendorType
  invoiceNumber String?
  invoiceDate  DateTime
  dueDate      DateTime?
  amount       Decimal  @db.Decimal(12, 2)
  isPaid       Boolean  @default(false)
  paidDate     DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, invoiceDate])
  @@map("vendor_invoices")
}

enum VendorType {
  FOOD
  ALCOHOL
  SUPPLIES
  OTHER
}

// ============================================================================
// Weekly Reports
// ============================================================================

model WeeklyReport {
  id           String       @id @default(cuid())
  restaurantId String
  weekStartDate DateTime    // Monday of the week
  weekEndDate   DateTime    // Sunday of the week
  status        ReportStatus @default(DRAFT)

  // Summary figures
  totalRevenue     Decimal? @db.Decimal(12, 2)
  totalExpenses    Decimal? @db.Decimal(12, 2)
  netCashFlow      Decimal? @db.Decimal(12, 2)

  // Cost percentages
  foodCostAmount   Decimal? @db.Decimal(12, 2)
  foodCostPct      Decimal? @db.Decimal(5, 2)
  laborCostAmount  Decimal? @db.Decimal(12, 2)
  laborCostPct     Decimal? @db.Decimal(5, 2)
  alcoholCostAmount Decimal? @db.Decimal(12, 2)
  alcoholCostPct   Decimal? @db.Decimal(5, 2)
  primeCostPct     Decimal? @db.Decimal(5, 2) // Food + Labor

  // Discounts & Voids
  totalDiscounts   Decimal? @db.Decimal(12, 2)
  totalVoids       Decimal? @db.Decimal(12, 2)

  // Account balances (snapshot)
  operatingBalance Decimal? @db.Decimal(12, 2)
  payrollBalance   Decimal? @db.Decimal(12, 2)
  salesTaxBalance  Decimal? @db.Decimal(12, 2)

  // Transfers
  payrollTransfer  Decimal? @db.Decimal(12, 2)
  taxTransfer      Decimal? @db.Decimal(12, 2)
  ownerDistribution Decimal? @db.Decimal(12, 2)

  notes        String?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekStartDate])
  @@index([restaurantId, status])
  @@map("weekly_reports")
}

enum ReportStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

// ============================================================================
// Integrations
// ============================================================================

model Integration {
  id           String          @id @default(cuid())
  restaurantId String
  provider     IntegrationProvider
  isActive     Boolean         @default(true)

  // OAuth tokens (encrypted in production)
  accessToken  String?         @db.Text
  refreshToken String?         @db.Text
  tokenExpiry  DateTime?

  // Provider-specific IDs
  externalId   String?

  lastSyncAt   DateTime?
  syncStatus   String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, provider])
  @@map("integrations")
}

enum IntegrationProvider {
  TOAST
  QUICKBOOKS
  GUSTO
  PLAID
}
