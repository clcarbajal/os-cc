# =============================================================================
# Restaurant Cash Flow Manager - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# Database
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_cashflow?schema=public"

# =============================================================================
# Authentication
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# Toast POS Integration
# =============================================================================
TOAST_CLIENT_ID=""
TOAST_CLIENT_SECRET=""
TOAST_API_URL="https://ws-api.toasttab.com"

# =============================================================================
# QuickBooks Integration
# =============================================================================
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/auth/callback/quickbooks"
QUICKBOOKS_ENVIRONMENT="sandbox"  # sandbox or production

# =============================================================================
# Gusto Integration
# =============================================================================
GUSTO_CLIENT_ID=""
GUSTO_CLIENT_SECRET=""
GUSTO_REDIRECT_URI="http://localhost:3000/api/auth/callback/gusto"

# =============================================================================
# Plaid (Bank Account Integration)
# =============================================================================
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"  # sandbox, development, or production

# =============================================================================
# Application Settings
# =============================================================================
# Timezone for report generation
DEFAULT_TIMEZONE="America/New_York"

# Day of week to generate reports (0 = Sunday, 1 = Monday)
REPORT_GENERATION_DAY="1"

# Time to generate reports (24-hour format)
REPORT_GENERATION_TIME="06:00"
